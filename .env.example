# The Odds API v4 key (https://the-odds-api.com). Server-side only — never exposed to the browser.
ODDS_API_KEY=

# true → use fixtures/ instead of the real API (no credits spent). Recommended for development.
USE_MOCK_DATA=true

# SQLite file (relative to project root). For PostgreSQL later: postgresql://user:pass@host:5432/terezi
DATABASE_URL=file:./prisma/dev.db

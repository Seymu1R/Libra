// SQLite now; PostgreSQL-portable: no provider-specific types. JSON is stored as String,
// enum-like fields are Strings validated in code (see lib/ types).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Sync {
  id                 String         @id @default(cuid())
  startedAt          DateTime       @default(now())
  finishedAt         DateTime?
  /// running | success | partial | failed
  status             String
  /// true when run against fixtures (USE_MOCK_DATA)
  mock               Boolean        @default(false)
  creditsUsed        Int            @default(0)
  creditsRemaining   Int?
  /// JSON: CompetitionResult[]
  competitionResults String         @default("[]")
  odds               OddsSnapshot[]
  templates          Template[]

  @@index([startedAt])
}

model Match {
  /// The Odds API event id
  id           String         @id
  competition  String
  homeTeam     String
  awayTeam     String
  commenceTime DateTime
  homeScore    Int?
  awayScore    Int?
  completed    Boolean        @default(false)
  odds         OddsSnapshot[]
  legs         TemplateLeg[]

  @@index([competition, commenceTime])
}

model OddsSnapshot {
  id             Int    @id @default(autoincrement())
  syncId         String
  matchId        String
  bookmaker      String
  bookmakerTitle String
  /// h2h | totals | spreads
  market         String
  outcome        String
  point          Float?
  price          Float
  sync           Sync   @relation(fields: [syncId], references: [id], onDelete: Cascade)
  match          Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([syncId, matchId])
}

model Template {
  id                  String        @id @default(cuid())
  createdAt           DateTime      @default(now())
  syncId              String
  /// SABIT | BALANSLI | RISKLI | CUSTOM
  type                String
  combinedProbability Float
  fairOdds            Float
  /// Phase 2: PENDING | WON | LOST | VOID
  status              String        @default("PENDING")
  settledAt           DateTime?
  sync                Sync          @relation(fields: [syncId], references: [id], onDelete: Cascade)
  legs                TemplateLeg[]

  @@index([syncId])
}

model TemplateLeg {
  id             String   @id @default(cuid())
  templateId     String
  matchId        String
  /// 1X2 | DC | OU25 | OU35 | OU45 · basketball: ML | SPR | TOT
  market         String
  /// 1X2: HOME|DRAW|AWAY · DC: 1X|X2|12 · OU*: OVER|UNDER · ML / SPR: HOME|AWAY · TOT: OVER|UNDER
  selection      String
  /// SPR: home handicap · TOT: points · null otherwise
  line           Float?
  probability    Float
  bookmakerCount Int
  /// Phase 2: WON | LOST | VOID
  result         String?
  template       Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

/// One row per HTTP call to The Odds API — quota headers are logged on every call.
model ApiCallLog {
  id                Int      @id @default(autoincrement())
  at                DateTime @default(now())
  endpoint          String
  httpStatus        Int
  requestsRemaining Int?
  requestsUsed      Int?
  requestsLast      Int?

  @@index([at])
}
